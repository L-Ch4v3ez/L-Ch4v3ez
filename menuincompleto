int tamanoCadena(char cad[]){
   int longitud;
   longitud=strlen(cad);///lamado ala funcion string length
   return longitud;
}

bool Prime(int num){
      int c;
   for(c=2;c<=num;c++){
      if(num%c ==0){
        return true;
      }}
    return false;
}

int llenaPrimos(int primos[], int mini, int maxi){
    bool primo;
    int i,k=0;
    for(i=mini;i<=maxi;i++){
            primo = Prime(i);

        if (Prime(i)== 1){
            primos[k]=i;
            k ++;
        }
    }
    return k;
}

void imprimir(int primos[],int n){
    for(int i=0;i<=n;i++){
        cout <<primos[i]<<" | ";
    }
}

void invertir(char word[], char finword[]){
    int n,i,k;
    n=strlen(word);
    k=n;
     for(i=0;i<k;i++){
        finword[i]=word[n-1];
        n--;
     }
}

